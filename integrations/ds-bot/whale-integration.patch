--- /dev/null
+++ b/ds-bot/test/whale.test.js
@@ -0,0 +1,25 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { bindWhale } from '../src/client/whale.js'
+import { currentPart } from '../src/client/text.js'
+
+test('whale binding submits the current conversation part with same-origin authentication',async t=>{
+  const original=globalThis.fetch;t.after(()=>{globalThis.fetch=original})
+  globalThis.fetch=async (path,options)=>{
+    assert.equal(path,'api/whale-voice');assert.equal(options.credentials,'same-origin')
+    assert.deepEqual(JSON.parse(options.body),{action:'bind',sessionId:'new-part',title:'Writer'})
+    return Response.json({ok:true,value:{sessionId:'new-part',title:'Writer'}})
+  }
+  const bot={id:'old-part',sessionId:'new-part',name:'Writer'}
+  assert.deepEqual(await bindWhale(currentPart(bot),bot.name),{sessionId:'new-part',title:'Writer'})
+})
+
+test('whale binding distinguishes a missing plugin, stale conversation and network failure',async t=>{
+  const original=globalThis.fetch;t.after(()=>{globalThis.fetch=original})
+  globalThis.fetch=async()=>new Response('<html>Not found</html>',{status:404})
+  await assert.rejects(bindWhale('part','Writer'),/Enable the dsh-whale-voice plugin/)
+  globalThis.fetch=async()=>Response.json({ok:false,error:'missing'},{status:404})
+  await assert.rejects(bindWhale('part','Writer'),/conversation is no longer available/)
+  globalThis.fetch=async()=>{throw new Error('offline')}
+  await assert.rejects(bindWhale('part','Writer'),/Could not reach DSH/)
+})
