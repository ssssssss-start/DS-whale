+  async request(action, extra = {}) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 5e3);
+    try {
+      const response = await fetch("api/whale-voice", {
+        method: "POST",
+        credentials: "same-origin",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ action, ...this.id ? { id: this.id } : {}, ...extra }),
+        signal: controller.signal,
+        keepalive: action === "call_end"
+      });
+      const result = await response.json().catch(() => null);
+      if (action === "call_start" && response.status === 404 && !result?.error) return null;
+      if (!response.ok || !result?.ok) throw new Error(t(result?.error || "Whale voice is unavailable. Open the companion and check Doubao voice and Sound."));
+      return result.value;
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+  accept(state) {
+    if (this.closed || !state || state.id !== this.id || state.revision < this.revision) return;
+    this.revision = state.revision;
+    this.onState(state);
+  }
+  async open(sessionId) {
+    const state = await this.request("call_start", { sessionId });
+    if (!state) return false;
+    this.id = state.id;
+    if (this.closed) {
+      await this.request("call_end").catch(() => {
+      });
+      return true;
+    }
+    this.accept(state);
+    this.poll();
+    return true;
+  }
+  poll() {
+    this.timer = setTimeout(async () => {
+      try {
+        this.accept(await this.request("call_poll"));
+      } catch {
+        if (!this.closed) {
+          this.onError();
+          this.close();
+        }
+        ;
+        return;
+      }
+      if (!this.closed) this.poll();
+    }, 250);
+  }
+  async control(action, extra = {}) {
+    const state = await this.request(action, extra);
+    this.accept(state);
+    return state;
+  }
