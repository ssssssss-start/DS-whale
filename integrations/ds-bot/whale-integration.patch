+  const original=globalThis.fetch;t.after(()=>{globalThis.fetch=original})
+  const actions=[],states=[]
+  globalThis.fetch=async(path,options)=>{
+    assert.equal(path,'api/whale-voice');assert.equal(options.credentials,'same-origin')
+    const body=JSON.parse(options.body);actions.push(body)
+    return Response.json({ok:true,value:{id:'mock-call',phase:body.action==='call_start'?'ready':'waiting',revision:body.action==='call_start'?1:3}})
+  }
+  const call=new WhaleCall(state=>states.push(state),()=>assert.fail('unexpected disconnect'))
+  t.after(()=>call.close())
+  assert.equal(await call.open('chosen'),true)
+  await call.control('call_prepare',{input:'asr'})
+  call.accept({id:'mock-call',revision:2,phase:'finished'})
+  call.accept({id:'old-call',revision:10,phase:'finished'})
+  assert.deepEqual(states.map(s=>s.phase),['ready','waiting'])
+  call.accept({id:'mock-call',revision:4,phase:'speaking'})
+  call.close();call.accept({id:'mock-call',revision:5,phase:'finished'})
+  assert.deepEqual(states.map(s=>s.phase),['ready','waiting','speaking'])
+  assert.deepEqual(actions,[{action:'call_start',sessionId:'chosen'},{action:'call_prepare',id:'mock-call',input:'asr'},{action:'call_end',id:'mock-call'}])
+})
+
+test('only an absent plugin permits browser voice; native/config failure never falls back',async t=>{
+  const original=globalThis.fetch;t.after(()=>{globalThis.fetch=original})
+  const call=new WhaleCall(()=>{},()=>{});t.after(()=>call.close())
+  globalThis.fetch=async()=>new Response('<html>not found</html>',{status:404})
+  assert.equal(await call.open('chosen'),false)
+  globalThis.fetch=async()=>Response.json({ok:false,error:'Configure Doubao voice and enable Sound in Whale Companion.'},{status:424})
+  await assert.rejects(call.open('chosen'),/Configure Doubao/)
+  globalThis.fetch=async()=>Response.json({ok:false,error:'This conversation is no longer available.'},{status:404})
+  await assert.rejects(call.open('chosen'),/conversation is no longer/)
+})
+
+test('closing while call setup is pending releases the late-created lease',async t=>{
+  const original=globalThis.fetch;t.after(()=>{globalThis.fetch=original})
+  let answer;const actions=[]
+  globalThis.fetch=async(_path,options)=>{
+    const body=JSON.parse(options.body);actions.push(body.action)
+    if(body.action==='call_start') return new Promise(resolve=>{answer=resolve})
+    return Response.json({ok:true,value:{ended:true}})
+  }
+  const call=new WhaleCall(()=>assert.fail('closed call cannot deliver state'),()=>{})
+  const pending=call.open('chosen');call.close()
+  answer(Response.json({ok:true,value:{id:'late-call',phase:'ready',revision:1}}))
+  await pending
+  assert.deepEqual(actions,['call_start','call_end'])
+})
