+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createRequire } from 'node:module'
+import { mkdtemp, writeFile, rm } from 'node:fs/promises'
+import { join, resolve } from 'node:path'
+import { tmpdir } from 'node:os'
+import { build } from 'esbuild'
+
+const harness=process.env.DSH_HARNESS ?? resolve(import.meta.dirname,'../../deepseek-harness')
+const fromHarness=createRequire(join(harness,'apps/web/package.json'))
+const {JSDOM}=fromHarness('jsdom')
+const React=fromHarness('react')
+const {createRoot}=fromHarness('react-dom/client')
+
+test('call UI waits for actual whale audio completion, suppresses browser speech and stops on hangup',async()=>{
+  const folder=await mkdtemp(join(tmpdir(),'whale-call-ui-'))
+  const dom=new JSDOM('<div id="root"></div>',{url:'http://localhost',pretendToBeVisual:true})
+  const previous=new Map()
+  function global(name,value) {previous.set(name,Object.getOwnPropertyDescriptor(globalThis,name));Object.defineProperty(globalThis,name,{value,writable:true,configurable:true})}
+  global('window',dom.window);global('document',dom.window.document);global('navigator',dom.window.navigator)
+  global('IS_REACT_ACT_ENVIRONMENT',true)
+  let root
+  try {
+    const result=await build({entryPoints:[resolve(import.meta.dirname,'../src/client/voice.js')],bundle:true,platform:'node',format:'cjs',write:false,plugins:[{
+      name:'test-react',setup(builder){
+        builder.onResolve({filter:/^react(?:-dom)?$/},args=>({path:fromHarness.resolve(args.path),external:true}))
+        builder.onResolve({filter:/^@deepseek-ai\/dsh-client-ui-primitives$/},()=>({path:'ui',namespace:'test-ui'}))
+        builder.onLoad({filter:/.*/,namespace:'test-ui'},()=>({contents:'export const MarkdownText = () => null'}))
+      },
+    }]})
+    const compiled=join(folder,'voice.cjs');await writeFile(compiled,result.outputFiles[0].text)
+    const {VoiceMode}=createRequire(import.meta.url)(compiled)
+    let starts=0,browserSpeech=0,engine,closed=0,running=false,outline=[]
+    class Recognition {
+      constructor(){engine=this}
+      start(){starts++}
+      stop(){this.onend?.()}
+      abort(){}
+    }
+    dom.window.SpeechRecognition=Recognition
+    dom.window.speechSynthesis={cancel(){},speak(){browserSpeech++}}
+    global('SpeechSynthesisUtterance',class {constructor(){browserSpeech++;throw new Error('Browser speech must not be used')}})
+    let state={id:'mock-call',phase:'ready',revision:1,turn:null}
+    const requests=[]
+    global('fetch',async(_url,options)=>{
+      const body=JSON.parse(options.body);requests.push(body.action)
+      if(body.action==='call_prepare')state={...state,phase:'waiting',revision:state.revision+1,turn:null}
+      if(body.action==='call_pause')state={...state,phase:'paused',revision:state.revision+1}
+      if(body.action==='call_resume')state={...state,phase:'ready',revision:state.revision+1,turn:null}
+      return Response.json({ok:true,value:state})
+    })
+    const props={sessionId:'chosen',roster:{byId:{},roomsById:{}},
+      actions:{speech:()=>undefined,closeVoice(){closed++},async send(){assert.ok(requests.includes('call_prepare'));running=true},voiceSetup:()=>null},
+      useSessions:select=>select({byId:{chosen:{projectionValues:{turnOutline:outline}}}}),
+      useSessionStatus:select=>select(new Map([['chosen',{running}]])),
+    }
+    const render=()=>React.act(async()=>root.render(React.createElement(VoiceMode,props)))
+    const wait=ms=>React.act(async()=>{await new Promise(resolve=>setTimeout(resolve,ms))})
+    root=createRoot(dom.window.document.getElementById('root'))
+    await render();await wait(300)
+    assert.equal(starts,1)
+    await React.act(async()=>engine.onresult({resultIndex:0,results:[Object.assign([{transcript:'你好'}],{isFinal:true})]}))
+    assert.ok(requests.includes('call_prepare'))
+    state={...state,phase:'speaking',turn:'chosen:1',revision:3,text:'你好呀，我在这里。'};await wait(300)
+    assert.match(dom.window.document.querySelector('.bt-voice-caption').textContent,/你好呀/,'captions precede durable outline updates')
+    running=false;outline=[{response:'你好呀，我在这里。'}];await render();await wait(300)
+    assert.equal(starts,1,'model completion must not resume the microphone')
+    assert.match(dom.window.document.body.textContent,/Voice: Whale Companion/)
+    assert.equal(browserSpeech,0)
+    running=true;outline=[];await render()
+    state={...state,phase:'finished',revision:4};await wait(300);await wait(80)
+    assert.equal(starts,2,'audio drain resumes recognition even while running and transcript projections lag')
+    assert.equal(dom.window.document.querySelector('[data-phase]').dataset.phase,'listening')
+    running=false;outline=[{response:'迟到的历史文本'}];await render();await wait(300)
+    assert.equal(starts,2,'late transcript does not restart speech or recognition')
+    assert.equal(browserSpeech,0)
+    assert.match(dom.window.document.querySelector('.bt-voice-caption').textContent,/你好呀/)
+    const pause=dom.window.document.querySelector('[aria-label="Pause"]')
+    await React.act(async()=>pause.click());assert.ok(requests.includes('call_pause'))
+    await wait(300);assert.equal(starts,2)
+    await React.act(async()=>dom.window.document.querySelector('[aria-label="Resume listening"]').click())
+    await wait(300);assert.equal(starts,3)
+    await React.act(async()=>dom.window.document.querySelector('[aria-label="End voice chat"]').click())
+    assert.equal(closed,1);assert.equal(requests.at(-1),'call_end')
+  } finally {
+    if(root)await React.act(async()=>root.unmount())
+    dom.window.close()
+    for(const [name,descriptor] of previous) {if(descriptor)Object.defineProperty(globalThis,name,descriptor);else delete globalThis[name]}
+    await rm(folder,{recursive:true,force:true})
+  }
+})
