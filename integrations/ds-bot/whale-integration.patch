diff --git a/ds-bot/src/client/whale.js b/ds-bot/src/client/whale.js
new file mode 100644
index 0000000..0076000
--- /dev/null
+++ b/ds-bot/src/client/whale.js
@@ -0,0 +1,22 @@
+import { t } from './i18n.js'
+
+export async function bindWhale(sessionId, title) {
+  let response
+  try {
+    response = await fetch('api/whale-voice', {
+      method:'POST', credentials:'same-origin', headers:{'content-type':'application/json'},
+      body:JSON.stringify({action:'bind',sessionId,title}),
+    })
+  } catch {
+    throw new Error(t('Could not reach DSH. Check that it is still running.'))
+  }
+  if (response.status === 404) {
+    // An absent plugin can return HTML; a registered route returns a JSON refusal.
+    const result = await response.json().catch(() => null)
+    if (result?.error) throw new Error(t('This conversation is no longer available. Refresh the sidebar and try again.'))
+    throw new Error(t('Enable the dsh-whale-voice plugin to bind Whale Companion.'))
+  }
+  const result = await response.json().catch(() => null)
+  if (!response.ok || !result?.ok) throw new Error(t('Whale binding is unavailable. Enable dsh-whale-voice and try again.'))
+  return result.value
+}
diff --git a/ds-bot/src/client/whale-call.js b/ds-bot/src/client/whale-call.js
new file mode 100644
index 0000000..1d57b14
--- /dev/null
+++ b/ds-bot/src/client/whale-call.js
@@ -0,0 +1,47 @@
+import { t } from './i18n.js'
+
+export class WhaleCall {
+  constructor(onState, onError) {
+    this.onState = onState; this.onError = onError
+    this.id = null; this.closed = false; this.revision = -1; this.timer = null
+  }
+  async request(action, extra = {}) {
+    const controller = new AbortController()
+    const timeout = setTimeout(() => controller.abort(), 5000)
+    try {
+      const response = await fetch('api/whale-voice', {
+        method:'POST', credentials:'same-origin', headers:{'content-type':'application/json'},
+        body:JSON.stringify({action,...(this.id ? {id:this.id} : {}),...extra}),
+        signal:controller.signal, keepalive:action === 'call_end',
+      })
+      const result = await response.json().catch(() => null)
+      if (action === 'call_start' && response.status === 404 && !result?.error) return null
+      if (!response.ok || !result?.ok) throw new Error(t(result?.error || 'Whale voice is unavailable. Open the companion and check Doubao voice and Sound.'))
+      return result.value
+    } finally { clearTimeout(timeout) }
+  }
+  accept(state) {
+    if (this.closed || !state || state.id !== this.id || state.revision < this.revision) return
+    this.revision = state.revision; this.onState(state)
+  }
+  async open(sessionId) {
+    const state = await this.request('call_start',{sessionId})
+    if (!state) return false
+    this.id = state.id
+    if (this.closed) { await this.request('call_end').catch(() => {}); return true }
+    this.accept(state); this.poll(); return true
+  }
+  poll() {
+    this.timer = setTimeout(async () => {
+      try { this.accept(await this.request('call_poll')) }
+      catch { if (!this.closed) { this.onError(); this.close() }; return }
+      if (!this.closed) this.poll()
+    }, 250)
+  }
+  async control(action, extra = {}) { const state = await this.request(action, extra); this.accept(state); return state }
+  close() {
+    if (this.closed) return
+    this.closed = true; clearTimeout(this.timer)
+    if (this.id) void this.request('call_end').catch(() => {})
+  }
+}
diff --git a/ds-bot/test/whale.test.js b/ds-bot/test/whale.test.js
new file mode 100644
