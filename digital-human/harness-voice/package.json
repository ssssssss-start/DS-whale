{
  "name": "dsh-whale-voice",
  "version": "0.5.5",
  "type": "module",
  "description": "Opt-in sentence voice bridge for the Whale desktop companion",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "sentences.js",
    "phrases.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "proactive.js",
    "host.js",
    "transport.js",
    "binding.js",
    "calls.js",
    "embodiment.js",
    "native-call.js",
    "launcher.js",
    "client.js",
    "src/client/",
    "scripts/build-client.mjs"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
